# Optional: direct admin login defaults (match server ADMIN_SEED_*)
# VITE_DEMO_ADMIN_EMAIL=admin@example.com
# VITE_DEMO_ADMIN_PASSWORD=change_me_123

# Optional: override demo button defaults (match server seed USER_SEED_*)
# VITE_DEMO_USER_EMAIL=user@example.com
# VITE_DEMO_USER_PASSWORD=demo123

# Optional: when UI and API are on different hosts
# VITE_API_URL=http://localhost:5000/api
